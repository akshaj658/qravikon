# Backend environment for apps/api. Keep populated values local and uncommitted.

# AI provider label supported by the server: openai, anthropic, groq, together, google
AI_PROVIDER=openai
AI_API_KEY=
AI_MODEL=gpt-4o-mini
# Optional OpenAI-compatible provider endpoint and quota fallback model
# AI_BASE_URL=https://api.openai.com/v1
AI_FALLBACK_MODEL=

# Optional live research
TAVILY_API_KEY=

# Supabase server credentials. Keep the service-role key server-side only.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Server and frontend origin
PORT=4000
NODE_ENV=development
CLIENT_URL=http://localhost:5173
