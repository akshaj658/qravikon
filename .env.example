# ─────────────────────────────────────────────────────────────────────────────
# Qravikon — Environment Variable Reference
# ─────────────────────────────────────────────────────────────────────────────
# This root file is a reference only. Workspace scripts load apps/api/.env and
# apps/web/.env.local. Copy the package-specific examples for local development.
# Never commit populated environment files. This template is safe to commit.

# ─── AI Provider ─────────────────────────────────────────────────────────────
# Supported labels: openai, anthropic, groq, together, google.
# Configure AI_BASE_URL when using a compatible non-OpenAI endpoint.
AI_PROVIDER=openai

# Backend-only provider credential
AI_API_KEY=

# Model identifier accepted by the selected provider
AI_MODEL=gpt-4o-mini

# Optional: endpoint for an OpenAI-compatible provider
# AI_BASE_URL=https://api.openai.com/v1
AI_FALLBACK_MODEL=

# ─── Web Research (Tavily) ────────────────────────────────────────────────────
# Optional backend-only research credential
TAVILY_API_KEY=

# ─── Supabase ────────────────────────────────────────────────────────────────
# Backend credentials. The service-role key must never be exposed to Vite.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ─── Backend ─────────────────────────────────────────────────────────────────
PORT=4000
NODE_ENV=development

# URL of the frontend (used for CORS)
CLIENT_URL=http://localhost:5173

# ─── Frontend (VITE_ values are included in browser bundles) ─────────────────
# Only the public Supabase URL and anon/publishable key belong here.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
VITE_API_URL=http://localhost:4000
